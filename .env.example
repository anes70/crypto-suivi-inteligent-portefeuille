# ==============================================================================
# Meridian — Configuration des variables d'environnement (100% Tier Gratuit)
# Copiez ce fichier vers `.env` en local ou ajoutez ces variables dans Vercel.
# ==============================================================================

# 1. Moteur IA Quantitatif (au moins une clé recommandée)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY — Google AI Studio (Tier Gratuit, modèle gemini-2.5-flash)
# Obtenir une clé gratuitement : https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# GROQ_API_KEY — Groq Cloud (Tier Gratuit, modèle llama-3.3-70b-versatile)
# Obtenir une clé gratuitement : https://console.groq.com/keys
GROQ_API_KEY=""

# 2. Indexation Blockchain Lecture Seule (optionnel — RPC publics en fallback)
# ------------------------------------------------------------------------------
# ALCHEMY_API_KEY — Base (EVM) : auto-détection complète des tokens ERC-20 & historique
# Obtenir une clé gratuitement : https://www.alchemy.com/ (Dashboard -> Create App -> Base Mainnet)
ALCHEMY_API_KEY=""
NEXT_PUBLIC_ALCHEMY_API_KEY=""

# ROBINHOOD_ALCHEMY_API_KEY — Robinhood Chain (EVM) : soldes natifs ETH, ERC-20 & historique
# Optionnel au démarrage : sans clé, l'app continue de fonctionner et invite à la configurer.
# Obtenir une clé gratuitement : https://www.alchemy.com/ (Dashboard -> Create App -> Robinhood Chain Mainnet)
ROBINHOOD_ALCHEMY_API_KEY=""
NEXT_PUBLIC_ROBINHOOD_ALCHEMY_API_KEY=""

# HELIUS_API_KEY — Solana : indexation SPL, métadonnées Token-2022 & historique de swaps
# Obtenir une clé gratuitement : https://www.helius.dev/ (Dashboard -> API Keys)
HELIUS_API_KEY=""
NEXT_PUBLIC_HELIUS_API_KEY=""

# 3. URL de l'application (injectée automatiquement par l'environnement d'hébergement)
# ------------------------------------------------------------------------------
APP_URL="http://localhost:3000"

